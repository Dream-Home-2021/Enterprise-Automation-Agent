# ===== LLM API Keys =====
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Reranker (optional)
RERANKER_MODEL=bge-reranker-v2-m3

# ===== PostgreSQL + PGVector =====
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/emotional_agent
POSTGRES_POOL_SIZE=10

# ===== LangSmith Tracing =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=dynamic-emotional-agent

# ===== Docker Sandbox =====
SANDBOX_IMAGE=emotional-agent-sandbox:latest
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT=10

# ===== App Config =====
APP_HOST=0.0.0.0
APP_PORT=8000
IDLE_THRESHOLD_MINUTES=5
MAX_SHORT_TERM_MESSAGES=12

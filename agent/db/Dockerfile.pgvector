# 基于 postgres:17.10-alpine 编译安装 pgvector 0.8.3
FROM postgres:17.10-alpine

# 安装编译依赖
RUN apk add --no-cache \
    build-base \
    clang22 \
    llvm22

# 从本地 COPY 源码（避免 GitHub 网络问题）
COPY pgvector /tmp/pgvector

# 创建 clang/llvm 符号链接（PGXS 需要 clang-21）
RUN ln -sf /usr/bin/clang-22 /usr/bin/clang-21 \
    && mkdir -p /usr/lib/llvm21/bin \
    && ln -sf /usr/lib/llvm22/bin/llvm-lto /usr/lib/llvm21/bin/llvm-lto

# 编译安装 pgvector
RUN cd /tmp/pgvector \
    && make \
    && make install \
    && rm -rf /tmp/pgvector

# 清理编译依赖
RUN apk del build-base clang22 llvm22
